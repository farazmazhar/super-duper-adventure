# =============================================================================
# App configuration (pydantic-settings) — loaded from this file.
# Precedence: process env > .env > defaults in apps/common/config.py.
# DO NOT COMMIT: this file is gitignored. Copy to .env and fill in values.
# =============================================================================

# --- OpenAI-compatible API (App 2 agent, App 4 mcp) ---
# Default endpoint is OpenRouter (get a key at https://openrouter.ai/keys);
# set OPENAI_BASE_URL to any OpenAI-compatible API.
# OPENAI_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=deepseek/deepseek-v4-flash-0731
OPENAI_EMBEDDING_MODEL=voyageai/voyage-4-lite
OPENAI_RERANK_MODEL=voyageai/rerank-2.5-lite
RERANK_ENABLED=true
MODERATION_ENABLED=true
# MODERATION_MODEL=meta-llama/llama-guard-4-12b
# MAX_INPUT_CHARS=4000
# Long-term memory: always written, retrieved only when enabled
# LTM_ENABLED=false
# Evaluator LLM-judge layer (Layer 2); skipped when off / no key
# EVAL_JUDGE_ENABLED=true
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.2

# --- Data paths (App 1 cleansing) ---
# DATA_DIR=/absolute/path/to/synthetic_customer_data
# DB_PATH=/absolute/path/to/data/intelligence.duckdb

# --- Agent (App 2) ---
# EMBEDDING_DIM=1024
# TOP_K=5
